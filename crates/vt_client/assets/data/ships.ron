// Ship classes. Every ship in the game is an instance of one of these, so
// editing a class here (or in the design panel) changes every ship wearing it.
//
// Any field may be omitted to inherit the compiled-in default — a class only
// needs to say how it differs. Live state (reload timers, loaded tubes, EMP
// soak) is deliberately not writable here; it belongs to a running ship, not to
// its class.
//
// Order matters: a ship refers to its class by position, so inserting a class in
// the middle reassigns live ships until the next restart. Append rather than
// insert while the game is running.
(
    classes: [
        (
            name: "corsair_sloop",
            class: (
                // The player's ship. Slow and stately, but handy: it is meant to
                // be fought by out-turning the other ship, not out-running it.
                stats: (
                    thrust: 115.0,
                    turn_rate: 0.6875,
                    max_speed: 127.5,
                    // Thrust is sized to just hold max_speed against forward drag
                    // (eq = 115 / 0.9 = 128). Lateral drag is 5x higher, so the
                    // hull leans through a turn instead of skidding.
                    forward_drag: 0.9,
                    lateral_drag: 4.5,
                    // Nearly 3x handier at a standstill than at full sail: spill
                    // your way, pivot, then make sail again.
                    turn_rate_slow: 1.55,
                    turn_rate_fast: 0.55,
                    turn_accel: 4.0,
                ),
                hull: 50.0,
                collider: (radius: 26.0),
                emp_defense: (resist: 100.0, recovery_per_sec: 14.0),
                loadout: (
                    // A heavy 10s broadside: one big decision, not a stream of shots.
                    broadside: (
                        cooldown: 10.0,
                        damage: 12.0,
                        muzzle_speed: 325.0,
                        guns: 3,
                        // 67.5 deg either way — a 135 deg arc centred on the beam.
                        arc: 1.1780972,
                        charge_time: 0.0,
                    ),
                    // The default fit: one device per slot. The loadout
                    // catalogue swaps which one, never how many — see
                    // assets/data/loadouts.ron. A slot left `None` here is a
                    // component the ship never carries at all.
                    battery: Some(()),
                    // The disruptor, not the boost drive: without something to
                    // slow a target, a ten-second reload never connects and a
                    // duel with the last survivor deadlocks.
                    emp: Some(()),
                    torpedoes: Some(()),
                    // Fore and aft banks of 22.5 against a 50-point hull, so a
                    // well-presented side roughly doubles your effective health
                    // and a badly-presented one gives you nothing. The 2.5s
                    // suppression is what stops it being a flat damage
                    // reduction: under sustained fire the struck bank stays at
                    // zero, so the answer is always to turn.
                    shield: (fore_max: 22.5, aft_max: 22.5, regen_per_sec: 7.0, regen_delay: 2.5),
                ),
                ai: (),
            ),
        ),
        (
            name: "house_patrol",
            class: (
                // The wave enemy. Heavier and slower than the sloop, and it
                // telegraphs a 0.5s charge so its shot is dodgeable.
                stats: (
                    thrust: 98.0,
                    turn_rate: 0.35,
                    max_speed: 100.0,
                    // Heavier than the sloop: grips harder, swings onto a new
                    // heading more slowly, and gains less from spilling way.
                    forward_drag: 0.95,
                    lateral_drag: 5.0,
                    turn_rate_slow: 1.35,
                    turn_rate_fast: 0.5,
                    turn_accel: 3.2,
                ),
                hull: 100.0,
                collider: (radius: 26.0),
                emp_defense: (resist: 100.0, recovery_per_sec: 14.0),
                loadout: (
                    broadside: (
                        cooldown: 2.8,
                        damage: 12.0,
                        muzzle_speed: 325.0,
                        guns: 3,
                        arc: 1.1780972,
                        charge_time: 0.5,
                    ),
                    // No kit at all: enemies always flew the broadside only
                    // (`use_abilities: false`), so now they simply do not carry
                    // the rest of it.
                ),
                ai: (
                    engage_range: 300.0,
                    fire_arc: 0.35,
                    flee_hull_frac: 0.25,
                    // Enemies fly the broadside only; the kit is the player's.
                    use_abilities: false,
                ),
            ),
        ),
        (
            name: "house_bastion",
            class: (
                // The finale. A siege platform, not a duellist: it barely
                // moves, and both its guns and its generator cover every
                // direction. Everything the run has taught about presenting a
                // side is wrong here, and so is looking for a side at all —
                // its shield is one pool, not two halves. The answer is not to
                // be hit: its shots are slow enough to read and it is far too
                // ponderous to follow you.
                stats: (
                    // Ponderous. It can just about hold station and come about,
                    // and that is all — you can always out-run it, which is what
                    // makes staying on its stern a skill rather than a stalemate.
                    thrust: 30.0,
                    turn_rate: 0.16,
                    max_speed: 34.0,
                    forward_drag: 0.9,
                    lateral_drag: 6.0,
                    turn_rate_slow: 1.2,
                    turn_rate_fast: 0.7,
                    turn_accel: 1.4,
                ),
                // Three times a patrol's hull.
                hull: 300.0,
                collider: (radius: 42.0),
                emp_defense: (resist: 220.0, recovery_per_sec: 20.0),
                loadout: (
                    // 360 degrees: arc is a *half*-width, so pi is every
                    // direction. A one-second cooldown makes it a constant
                    // pressure rather than a telegraphed punch, and the damage
                    // is well down per shot to pay for that.
                    broadside: (
                        cooldown: 1.0,
                        damage: 5.0,
                        muzzle_speed: 300.0,
                        guns: 2,
                        arc: 3.14159265,
                        charge_time: 0.0,
                    ),
                    // Pooled: one charge over the whole hull, so there is no
                    // side of this thing worth manoeuvring for. Two equal banks
                    // would only have moved the trick — flatten the near side,
                    // swing round, find the far one full. The 3s suppression is
                    // what the fight is really fought over: break contact and it
                    // starts coming back.
                    shield: (pooled: true, fore_max: 120.0, aft_max: 0.0, regen_per_sec: 9.0, regen_delay: 3.0),
                ),
                ai: (
                    // It never needs to present a beam, so it simply closes and
                    // keeps firing. A wide fire_arc means "shoot whenever in
                    // range"; aim_at_target lays the guns on you.
                    engage_range: 520.0,
                    fire_arc: 3.14159265,
                    aim_at_target: true,
                    flee_hull_frac: 0.0,
                    use_abilities: false,
                ),
            ),
        ),
    ],
)
